# pico Linux for the BARG SoC: tinyconfig + this
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_MMU=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_V=n
CONFIG_EFI=n
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_HVC_RISCV_SBI=y
CONFIG_OF=y
CONFIG_SIFIVE_PLIC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/home/USER/linux-work/pico/initramfs.list"
CONFIG_RD_GZIP=n
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CMDLINE="earlycon=sbi console=ttyS0 console=tty0 rdinit=/init loglevel=7"
CONFIG_CMDLINE_FORCE=y
CONFIG_MODULES=n
CONFIG_BLOCK=n
CONFIG_NET=n
CONFIG_PRINTK_TIME=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_VGA_CONSOLE=n
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
# screen, keyboard and mouse (PS/2 through the Altera UP controller), the PLIC delivers their interrupts
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO=y
CONFIG_SERIO_ALTERA_PS2=y
CONFIG_FB=y
CONFIG_FB_BARG=y
CONFIG_FB_DEFERRED_IO=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=n
CONFIG_HZ_1000=y
